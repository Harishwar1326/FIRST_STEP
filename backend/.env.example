PORT=5000
MONGO_URI=mongodb://localhost:27017/firststep
DATABASE_URL=postgresql://firststep:firststep@localhost:5432/firststep
# Hosted PostgreSQL, for example Neon, usually needs sslmode=require:
# DATABASE_URL=postgresql://username:password@host/database?sslmode=require
REDIS_URL=redis://localhost:6379
AI_SERVICE_URL=http://localhost:8000
# Optional Thinking Lab integrations. Leave keys empty for fallback card generation.
GEOAPIFY_API_KEY=your_geoapify_api_key_here
GEOAPIFY_PLACES_URL=https://api.geoapify.com/v2/places
THINKING_LAB_NEARBY_RADIUS_METERS=10000
THINKING_LAB_AI_PROVIDER=internal
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
# Google Gemini – used as the primary AI provider for Smart Notes (Analysis, Learning, Blind Spots, QA, Drawing, Revision)
# Falls back to Groq automatically if the key is missing or the call fails.
GEMINI_API_KEY=your_gemini_api_key_here
ENTITY_AI_API_KEY=your_entity_ai_api_key_here
# Optional alternate env var; either works.
# GOOGLE_API_KEY=<your-google-ai-studio-api-key-here>
GEMINI_MODEL=gemini-1.5-flash
# Model used for JSON output requests (supports responseMimeType=application/json).
GEMINI_JSON_MODEL=gemini-1.5-flash
GEMINI_API_URL_BASE=https://generativelanguage.googleapis.com/v1beta
# Chroma Cloud – vector store for Smart Notes hybrid semantic search (dense + sparse with RRF).
# Sign up at https://trychroma.com – all four vars must be set for indexing/search to activate;
# the backend still runs without them (features fall back gracefully to local-only behaviour).
CHROMA_HOST=api.trychroma.com
CHROMA_API_KEY=your_chroma_api_key_here
CHROMA_TENANT=ffe9bf8a-1be9-4311-b859-92e27dc28782
CHROMA_DATABASE=FIRST_STEP
JWT_SECRET=your_super_secret_jwt_key_here
NODE_ENV=development
# For local development: CORS_ORIGINS=http://localhost:3000
# For production with Vercel frontend: CORS_ORIGINS=https://your-vercel-app.vercel.app
# For multiple origins: CORS_ORIGINS=http://localhost:3000,https://your-vercel-app.vercel.app
CORS_ORIGINS=http://localhost:3000

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_strong_password
ADMIN_NAME=FirstStep Admin
